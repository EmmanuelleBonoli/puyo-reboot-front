{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "dom"],
    "module": "esnext",
    "types": ["vite/client", "jest"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false
  },
  "include": ["src/**/*.spec.ts", "src/**/*.test.ts", "tests/**/*.ts"],
  "exclude": []
}
